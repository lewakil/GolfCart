# Golf Cart Tracker runs with demo telemetry by default.
GOLF_CART_PROVIDER=demo

# Optional live Trackunit provider.
# GOLF_CART_PROVIDER=trackunit
# TRACKUNIT_ACCESS_TOKEN=
# TRACKUNIT_CLIENT_ID=
# TRACKUNIT_CLIENT_SECRET=
# TRACKUNIT_SCOPES=api
# TRACKUNIT_USERNAME=
# TRACKUNIT_PASSWORD=
# TRACKUNIT_LEGACY_CLIENT_ID=
# TRACKUNIT_LEGACY_CLIENT_SECRET=
# TRACKUNIT_LEGACY_SCOPES=api
